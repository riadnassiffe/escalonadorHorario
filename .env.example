POSTGRES_USER=escalonador
POSTGRES_PASSWORD=escalonador
POSTGRES_DB=escalonador
DATABASE_URL=postgresql+asyncpg://escalonador:escalonador@localhost:5432/escalonador
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=dev-secret-change-me-in-production-32bytes
APP_ENV=development
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

# Configuração SMTP opcional (em APP_ENV=development, sem SMTP_HOST o link de redefinição é exibido localmente)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@escalonador.internal
SMTP_USE_TLS=true
SMTP_USE_SSL=false
